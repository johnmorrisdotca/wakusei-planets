  "scripts": {
    "export:data": "node scripts/export-data.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/copy-textures.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.demo.json",
    "test": "node --test test/*.test.ts",
    "test:package": "pnpm build && node scripts/check-package.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/check-package.ts",
    "prepublishOnly": "pnpm check",
    "tiles": ".cache/venv/bin/python -I scripts/make-body-tiles.py build",
    "test:tiles": ".cache/venv/bin/python -I scripts/make-body-tiles.py selftest",
    "family:readme": "node scripts/family-readme.mjs",
    "readme:images": "node scripts/readme-images.mjs",
    "site": "pnpm build && node scripts/site.ts",
    "dev": "pnpm site && node scripts/dev.ts",
    "test:demo": "pnpm site && node scripts/docs-site.mjs build && playwright test --project=chromium-desk --project=chromium-phone --project=webkit-desk --project=webkit-phone",
    "test:demo:one": "pnpm site && node scripts/docs-site.mjs build && playwright test",
    "test:freeze": "pnpm site && playwright test --project=freeze",
    "test:soak": "pnpm site && playwright test --project=soak",
    "screenshots": "pnpm site && node scripts/screenshots.ts",
    "docs:site": "pnpm build && node scripts/docs-site.mjs build",
    "docs:check": "pnpm build && node scripts/docs-site.mjs check",
    "size": "node scripts/docs-site.mjs size",
    "test:usage": "pnpm site && node scripts/check-usage.ts",
    "check:standard": "node scripts/check-standard.mjs",
    "test:readme": "pnpm build && node scripts/check-usage.ts readme"
  },
